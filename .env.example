# ==============================================================================
# PromptRadar Environment Configuration Template
# Copy this file to .env before running: cp .env.example .env
# ==============================================================================

# --- PostgreSQL Database ---
POSTGRES_DB=prompt_radar
POSTGRES_USER=radar
POSTGRES_PASSWORD=radar_password
POSTGRES_PORT=5432

# --- Spring Boot Control Plane ---
CONTROL_PLANE_PORT=8080
# SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/prompt_radar

# --- Go Proxy Data Plane ---
PROXY_PORT=8081
CONTROL_PLANE_URL=http://radar-control-plane:8080/api/v1/telemetry

# --- Optional LLM API Keys ---
# Provide your Google Gemini API Key for live completions:
# GEMINI_API_KEY=AIzaSy...

# --- Angular UI ---
UI_PORT=4200
